# ===== 中转站生图接口 =====
# 你提供的示例地址是 https://api.apikey.fan/v1，这里填写到 /v1 为止。
IMAGE_API_BASE=https://api.apikey.fan/v1
# 密钥只保存在本机 .env，不要提交到仓库，也不要发给前端。
IMAGE_API_KEY=
# 按中转站 image2.5 的实际模型 ID 修改；示例代码里使用的是 gpt-image-2。
IMAGE_MODEL=gpt-image-2
IMAGE_TIMEOUT_SECONDS=900
# 同时执行的任务数，建议 1，避免触发中转站限流。
IMAGE_WORKERS=1
# 本地演示模式：不调用真实接口，生成占位图。真实使用请设为 false。
IMAGE_MOCK=false

# ===== 应用 =====
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DATA_DIR=./data
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 生产构建后由 FastAPI 托管 frontend/dist，单地址访问。
SERVE_FRONTEND=true
